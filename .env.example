# Environment template

APP_NAME=VisionForge AI
APP_ENV=development
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_USER=visionforge
POSTGRES_PASSWORD=visionforge
POSTGRES_DB=visionforge
DATABASE_URL=postgresql://visionforge:visionforge@postgres:5432/visionforge

REDIS_URL=redis://redis:6379/0

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

AI_MOCK_MODE=true
AI_DEVICE=cpu

VIDEO_PROVIDER_API_KEY=
IMAGE_PROVIDER_API_KEY=
VOICE_PROVIDER_API_KEY=
AUDIO_PROVIDER_API_KEY=

# Optional real model provider configuration
# OPENAI_API_KEY=
# STABILITY_API_KEY=
# REPLICATE_API_KEY=
# RUNWAY_API_KEY=

# S3 storage (leave blank for local storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin
ADMIN_EMAIL=admin@visionforge.ai
ADMIN_PASSWORD=admin123

# Rate limit settings
RATE_LIMIT_PER_MINUTE=60
